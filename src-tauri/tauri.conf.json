{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalOffice",
  "version": "0.1.0",
  "identifier": "com.saikojin.localoffice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalOffice",
        "width": 1280,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["docx", "doc"],
        "name": "Word Document",
        "description": "Microsoft Word Document",
        "role": "Editor"
      },
      {
        "ext": ["xlsx", "xls", "csv"],
        "name": "Spreadsheet",
        "description": "Spreadsheet Document",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Editor"
      }
    ]
  }
}
